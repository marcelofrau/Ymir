{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "config-platform-uwp",
      "displayName": "UWP (Xbox Dev Mode) configuration",
      "description": "Configures a Universal Windows Platform build (CMAKE_SYSTEM_NAME=WindowsStore) using the Visual Studio 2026 generator. Requires the SDL3-uwp prebuilt dependencies in out/uwp-deps (see scripts/uwp/build-deps.ps1).",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "WindowsStore",
        "CMAKE_SYSTEM_VERSION": "10.0",
        "CMAKE_PREFIX_PATH": "${sourceDir}/out/uwp-deps",
        "VCPKG_TARGET_TRIPLET": "x64-uwp-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlay-ports/uwp",
        "Ymir_ENABLE_SANDBOX": "OFF",
        "Ymir_ENABLE_TESTS": "OFF",
        "Ymir_ENABLE_YMDASM": "OFF",
        "Ymir_ENABLE_UPDATE_CHECKS": "OFF",
        "Ymir_ENABLE_DISCORD_RPC": "OFF",
        "Ymir_ENABLE_UPDATE_CHECKER": "OFF",
        "Ymir_FF_HOST_CD_DRIVES": "OFF"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    }
  ]
}
